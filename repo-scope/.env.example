# Recommended for GitHub API rate limits and private-repo access when the token permits it.
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10

# Optional LLM analyst. Leave blank and RepoScope uses its local explainable summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

CACHE_TTL_SECONDS=3600
GITHUB_MAX_PAGES=3
REQUEST_TIMEOUT_SECONDS=15
