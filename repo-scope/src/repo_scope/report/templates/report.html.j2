<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>RepoScope — {{ data.stats.repo.full_name }}</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <style>
    :root{--bg:#070b14;--panel:#0e1626;--panel2:#111b2e;--line:#23304a;--text:#f7f9fc;--muted:#93a4bd;--cyan:#35d7ff;--violet:#8b5cf6;--green:#34d399;--amber:#fbbf24;--red:#fb7185}
    *{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 15% 0,#102344 0,transparent 28%),radial-gradient(circle at 90% 10%,#27164d 0,transparent 25%),var(--bg);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .wrap{max-width:1180px;margin:auto;padding:42px 24px 70px}.top{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:32px}.brand{font-weight:800;letter-spacing:.04em;font-size:20px}.brand span{color:var(--cyan)}.stamp{color:var(--muted);font-size:12px}
    .hero{display:grid;grid-template-columns:1.45fr .55fr;gap:18px;margin-bottom:18px}.card{background:linear-gradient(180deg,rgba(18,28,47,.94),rgba(10,16,29,.95));border:1px solid rgba(102,132,177,.2);border-radius:22px;padding:22px;box-shadow:0 22px 70px rgba(0,0,0,.22)}
    h1{font-size:38px;line-height:1.07;margin:0 0 10px}.desc{color:var(--muted);max-width:720px;margin:0 0 18px}.chips{display:flex;gap:8px;flex-wrap:wrap}.chip{padding:7px 10px;border-radius:999px;background:#0a1323;border:1px solid var(--line);color:#cbd5e1;font-size:12px}
    .score{display:flex;align-items:center;justify-content:center;min-height:190px;flex-direction:column}.score-num{font-size:58px;font-weight:850;letter-spacing:-.04em}.score-num small{font-size:18px;color:var(--muted)}.score-label{color:var(--cyan);font-weight:700}
    .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:14px 0}.metric .k{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em}.metric .v{font-size:25px;font-weight:800;margin-top:7px}.metric .s{font-size:12px;color:var(--muted);margin-top:3px}
    .two{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:14px 0}.section-title{font-size:16px;font-weight:800;margin:0 0 14px}.chart{height:280px}.alerts{display:grid;gap:9px}.alert{padding:12px 14px;border-radius:14px;border:1px solid var(--line);background:#0a1220}.alert.critical{border-color:rgba(251,113,133,.45)}.alert.warning{border-color:rgba(251,191,36,.35)}.alert.info{border-color:rgba(53,215,255,.25)}
    .langs{display:grid;gap:10px}.lang-row{display:grid;grid-template-columns:110px 1fr 50px;gap:10px;align-items:center}.bar{height:8px;border-radius:999px;background:#111d32;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,var(--cyan),var(--violet));border-radius:999px}.summary{font-size:15px;color:#dce6f5}.signals{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.signal{padding:10px;border-radius:12px;border:1px solid var(--line);color:var(--muted)}.signal.yes{color:var(--green)}.signal.no{color:var(--amber)}
    footer{color:var(--muted);text-align:center;margin-top:26px;font-size:12px}@media(max-width:850px){.hero,.two{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}.signals{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.wrap{padding:24px 14px 50px}.grid{grid-template-columns:1fr}h1{font-size:31px}}
  </style>
</head>
<body>
<div class="wrap">
  <div class="top"><div class="brand">Repo<span>Scope</span></div><div class="stamp">Generated {{ data.generated_at }}</div></div>
  <div class="hero">
    <section class="card">
      <h1>{{ data.stats.repo.full_name }}</h1>
      <p class="desc">{{ data.stats.repo.description or "No repository description provided." }}</p>
      <div class="chips">
        <span class="chip">★ {{ data.stats.repo.stars }}</span><span class="chip">⑂ {{ data.stats.repo.forks }}</span>
        {% for topic in data.stats.repo.topics[:6] %}<span class="chip">{{ topic }}</span>{% endfor %}
      </div>
    </section>
    <section class="card score"><div class="score-num">{{ data.stats.health.score }}<small>/100</small></div><div class="score-label">{{ data.stats.health.label }}</div></section>
  </div>

  <div class="grid">
    <div class="card metric"><div class="k">Commits / 90d</div><div class="v">{{ data.stats.activity.commits_90d }}</div><div class="s">{{ data.stats.activity.sampled_commits }} recent commits sampled</div></div>
    <div class="card metric"><div class="k">Bus factor</div><div class="v">{{ data.stats.contributors.bus_factor }}</div><div class="s">50% contribution threshold</div></div>
    <div class="card metric"><div class="k">Issue closure</div><div class="v">{{ data.stats.issues.closure_rate_pct if data.stats.issues.closure_rate_pct is not none else "—" }}{% if data.stats.issues.closure_rate_pct is not none %}%{% endif %}</div><div class="s">sampled issues</div></div>
    <div class="card metric"><div class="k">PR merge</div><div class="v">{{ data.stats.pull_requests.merge_rate_pct if data.stats.pull_requests.merge_rate_pct is not none else "—" }}{% if data.stats.pull_requests.merge_rate_pct is not none %}%{% endif %}</div><div class="s">closed PR sample</div></div>
  </div>

  <div class="two">
    <section class="card"><h2 class="section-title">Activity trend</h2><div class="chart"><canvas id="commitsChart"></canvas></div></section>
    <section class="card"><h2 class="section-title">Issues opened vs closed</h2><div class="chart"><canvas id="issuesChart"></canvas></div></section>
  </div>

  <div class="two">
    <section class="card"><h2 class="section-title">Smart summary</h2><p class="summary">{{ data.smart_summary }}</p><h2 class="section-title" style="margin-top:22px">Engineering signals</h2><div class="signals">
      {% for key, value in data.stats.signals.items() %}<div class="signal {{ 'yes' if value else 'no' }}">{{ key.replace('_',' ')|title }} · {{ 'Detected' if value else 'Missing' }}</div>{% endfor %}
    </div></section>
    <section class="card"><h2 class="section-title">Alerts</h2><div class="alerts">{% for alert in data.alerts %}<div class="alert {{ alert.level }}"><strong>{{ alert.level|upper }}</strong> · {{ alert.message }}</div>{% endfor %}</div></section>
  </div>

  <section class="card"><h2 class="section-title">Languages</h2><div class="langs">{% for lang in data.stats.languages[:8] %}<div class="lang-row"><span>{{ lang.name }}</span><div class="bar"><div class="fill" style="width:{{ lang.percent }}%"></div></div><span>{{ lang.percent }}%</span></div>{% endfor %}</div></section>
  <footer>RepoScope measures recent GitHub API samples; use the metrics as engineering signals, not as an absolute quality verdict.</footer>
</div>
<script>
const data={{ data_json|safe }};
Chart.defaults.color='#93a4bd';Chart.defaults.borderColor='rgba(148,163,184,.12)';
const commits=data.timeseries.commits.slice(-12);new Chart(document.getElementById('commitsChart'),{type:'line',data:{labels:commits.map(x=>x.date),datasets:[{label:'Commits',data:commits.map(x=>x.count),borderColor:'#35d7ff',backgroundColor:'rgba(53,215,255,.12)',fill:true,tension:.35}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{display:false}},y:{beginAtZero:true}}}});
const issues=data.timeseries.issues.slice(-12);new Chart(document.getElementById('issuesChart'),{type:'bar',data:{labels:issues.map(x=>x.date),datasets:[{label:'Opened',data:issues.map(x=>x.opened),backgroundColor:'#8b5cf6'},{label:'Closed',data:issues.map(x=>x.closed),backgroundColor:'#34d399'}]},options:{responsive:true,maintainAspectRatio:false,scales:{x:{stacked:false,grid:{display:false}},y:{beginAtZero:true}}}});
</script>
</body>
</html>
